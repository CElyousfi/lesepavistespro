# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SEO analytics data (sensitive)
/SEO DATA/
scripts/radar-report.json

# Temporary images
*.jpeg
*.jpg
*.png
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
# Crawl dumps stay local / CI artifacts; only the weekly monitor summary JSON is versioned (S2.5).
seo-audit/*
!seo-audit/monitor/
seo-audit/monitor/*
!seo-audit/monitor/*.json
# Search Console loop (S3.1): raw exports and the full snapshot stay local;
# the history (decliners), the opportunity report and the CTR test are kept.
!seo-audit/gsc-history/
!seo-audit/striking-distance.md
!seo-audit/striking-distance.json
!seo-audit/ctr-test.json
!seo-audit/citations.csv

# Unrelated client exports occasionally dropped in the repo root
/Audit de cotisations sociales*.html
.worktrees/
!seo-audit/outreach-templates.md
