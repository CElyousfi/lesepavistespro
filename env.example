# Google Analytics 4 Configuration
# Get your Measurement ID from: https://analytics.google.com/analytics/web/
# Admin > Data Streams > Web > Measurement ID (format: G-XXXXXXXXXX)

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Sheets Webhook (Google Apps Script Web App URL)
# See GOOGLE-SHEETS-SETUP.md for setup instructions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
